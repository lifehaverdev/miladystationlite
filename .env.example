# RPC that Anvil should fork from (also checks MAINNET_RPC_URL)
# FORK_RPC_URL=https://eth.llamarpc.com
# MAINNET_RPC_URL=https://your-rpc-provider.com

# Local JSON-RPC endpoint exposed by Anvil
RPC_URL=http://127.0.0.1:8545

# Chain ID for the local fork (1337 matches common localhost MetaMask config)
CHAIN_ID=1337

# Fund this address with ETH after fork starts (set to your wallet address)
# USER_ADDRESS=0x1821bd18cbdd267ce4e389f893ddfe7beb333ab6
# USER_FUNDING_ETH=10.0

# Block time in seconds (default 2)
# ANVIL_BLOCK_TIME=2
